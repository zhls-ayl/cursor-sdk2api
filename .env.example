# Listen. 0.0.0.0 exposes /v1 and /health on the LAN. /console and
# /v0/management stay loopback-only in-process and ignore forwarded IPs.
HOST=0.0.0.0
PORT=8080
# Host-side published port used by docker-compose.yml.
GATEWAY_PORT=8080
# Optional compose bind address. Default publishes on all interfaces.
# GATEWAY_BIND=0.0.0.0
# Compose shutdown allowance; keep above RUN_DEADLINE_MS plus 10 seconds.
# GATEWAY_STOP_GRACE_PERIOD=61m

# managed (recommended): clients use one GATEWAY_ACCESS_KEY and the console
# manages a persistent pool of Cursor accounts. byok remains available for a
# trusted single-user sidecar.
AUTH_MODE=managed

# Required when AUTH_MODE=managed. Never commit a real value.
GATEWAY_ACCESS_KEY=replace-with-a-random-gateway-key
# Optional seed account; use it to initialize managed Docker bridge deployments.
# Browser console import requires a socket local to the gateway's network namespace.
# CURSOR_API_KEY=

# Optional outbound proxy for the official Cursor SDK. When a routing proxy is
# set, the gateway routes Agent and SDK fetch traffic through the same HTTP(S)
# proxy and honors NO_PROXY (uppercase or lowercase). SOCKS/PAC is rejected.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# ALL_PROXY=http://127.0.0.1:7890
# NO_PROXY=127.0.0.1,localhost

# Optional stable instance id. A new process always has a new in-memory generation.
# INSTANCE_ID=

# Concurrency and lifetime
GLOBAL_ACTIVE_RUNS=4
PER_CREDENTIAL_ACTIVE_RUNS=2
MAX_AWAITING_SESSIONS=32
SESSION_TTL_MS=1800000
REPLAY_TTL_MS=600000
RUN_DEADLINE_MS=3600000
FIRST_EVENT_TIMEOUT_MS=40000
# Debounce from the latest SDK custom-tool callback. Real Claude callbacks can
# arrive more than one second apart within the same assistant turn.
TOOL_BATCH_SETTLE_MS=1500
CATALOG_CACHE_MS=300000
# Per-credential refresh singleflight; callers stop waiting after this deadline.
# A timed-out SDK query holds its key until it settles, preventing overlapping retries.
CATALOG_REFRESH_TIMEOUT_MS=5000
CATALOG_RETRY_MS=5000
# Refresh failures may use old models for this long beyond CATALOG_CACHE_MS.
# Set to 0 to disable stale fallback. This cache does not bypass upstream auth.
CATALOG_MAX_STALE_MS=300000
SWEEP_INTERVAL_MS=5000
MAX_BODY_BYTES=2097152

# Empty workspace used as SDK cwd. Leave unset to use a process temp dir.
# EMPTY_WORKSPACE_DIR=
# Persistent official Jsonl SDK store + owner-only lineage (0700/0600).
# Dev default: $TMPDIR/cursor-sdk2api/state
# Docker / compose: /data (named volume)
# STATE_DIR=

# Optional override for a prebuilt Operator Console bundle.
# Default: <application cwd>/dist/console
# CONSOLE_DIR=

LOG_LEVEL=info
# Never enable payload logging on a shared host.
